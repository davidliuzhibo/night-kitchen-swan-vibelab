<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name=".platform.NightKitchenApp"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NightKitchenTheme">
        <meta-data android:name="pico.spatial.use_experimental_api" android:value="1" />
        <activity android:name=".platform.LaunchActivity" android:exported="true"
            android:theme="@style/Theme.NightKitchenTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="pico.spatial.windowcontainer.id" android:value="kitchen-volume" />
            <meta-data android:name="pico.spatial.windowcontainer.style" android:value="2" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize" android:value="1.28x0.96x0.62" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize.unit" android:value="meters" />
            <meta-data android:name="pico.spatial.windowcontainer.resizetype" android:value="2" />
            <meta-data android:name="pico.spatial.windowcontainer.resizerestriction" android:value="1" />
            <meta-data android:name="pico.spatial.windowcontainer.worldscaletype" android:value="2" />
            <meta-data android:name="pico.spatial.windowcontainer.materialbackground" android:value="0" />
            <meta-data android:name="pico.spatial.windowcontainer.volumealignment" android:value="0" />
        </activity>
        <activity android:name=".platform.OrderBoardActivity" android:exported="false"
            android:theme="@style/Theme.NightKitchenTheme" />
        <activity android:name=".platform.ReviewSlipActivity" android:exported="false"
            android:theme="@style/Theme.NightKitchenTheme" />
    </application>
</manifest>
